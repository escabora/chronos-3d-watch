{
  "name": "chronos-3d-watch",
  "version": "2.0.0",
  "description": "CHRONOS — immersive scroll-driven 3D watch experience",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "npm run clean && webpack --mode production",
    "clean": "rimraf dist",
    "preview": "npm run build && http-server dist -p 4173 -c-1 -o",
    "format": "prettier --write \"src/**/*.{js,scss,json}\""
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "dependencies": {
    "animejs": "^3.2.2",
    "gsap": "^3.12.5",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "html-webpack-plugin": "^5.6.0",
    "http-server": "^14.1.1",
    "mini-css-extract-plugin": "^2.9.0",
    "nunjucks": "^3.2.4",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "sass": "^1.77.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
